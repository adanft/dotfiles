{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "$HOME/.config/fastfetch/logo.txt",
    "color": {
      "1": "blue",
      "2": "green",
      "3": "black"
    },
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": "    ",
    "color": {
      "separator": "red"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "{#90} {#31} {#32} {#33} {#34} {#35} {#36} {#37} {#38} {#39}   {#38} {#37} {#36} {#35} {#34} {#33} {#32} {#31} {#90} "
    },
    "separator",
    {
      "type": "os",
      "key": "{icon}",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "yellow"
    },
    "separator",
    {
      "type": "shell",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "theme",
      "key": "󰉼",
      "keyColor": "blue"
    },
    {
      "type": "cursor",
      "key": "󰳽",
      "keyColor": "blue"
    },

    {
      "type": "terminal",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "font",
      "key": "",
      "keyColor": "blue"
    },
    "separator",
    {
      "type": "cpu",
      "key": "󰻠",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "󰍛",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "󰍹",
      "keyColor": "green"
    },
    "separator",
    {
      "type": "custom",
      "format": "{#90} {#31} {#32} {#33} {#34} {#35} {#36} {#37} {#38} {#39}   {#38} {#37} {#36} {#35} {#34} {#33} {#32} {#31} {#90} "
    }
  ]
}
